        "postId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "postId"]
    },
    "SavedPost": {
      "title": "SavedPost",
      "description": "User bookmarked post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "postId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "postId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Social notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "actor": { "type": "object" },
